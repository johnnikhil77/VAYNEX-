# ---------------------------------------------------------------------------
# Vaynex configuration. Copy to `.env` and adjust. Never commit `.env`.
# ---------------------------------------------------------------------------
PROJECT_NAME=Vaynex
ENVIRONMENT=development
VERSION=0.1.0

HOST=0.0.0.0
PORT=8000

LOG_LEVEL=INFO
# LOG_JSON=true   # structured JSON logs

# Inside docker compose the API uses the service hostnames below.
# Running the API directly on your machine? Use localhost:5433 / localhost:6380.
DATABASE_URL=postgresql+asyncpg://vaynex:vaynex@postgres:5432/vaynex

REDIS_URL=redis://redis:6379/0
DASHBOARD_CACHE_TTL_SECONDS=15

# Generate a strong value for anything shared:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-in-development
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# AI provider: auto (OpenAI if a key is set, otherwise mock) | mock | openai
AI_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

CORS_ALLOWED_ORIGINS=["http://localhost:3000"]

# Demo data (docker compose seeds automatically when true)
SEED_DEMO_DATA=true
# DEMO_ADMIN_PASSWORD=
# DEMO_OPERATOR_PASSWORD=
# DEMO_VIEWER_PASSWORD=
